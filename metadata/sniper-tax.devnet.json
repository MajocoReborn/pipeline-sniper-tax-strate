        { "name": "amount_quote", "type": "u64", "label": "Quote to put in the pool", "decimals_of": "mint:1" }
      ],
      "accounts": [
        { "name": "creator", "source": "wallet", "signer": true, "writable": true },
        { "name": "pool", "source": "market_state", "writable": true },
        { "name": "token_mint", "source": "mint:0" },
        { "name": "quote_mint", "source": "mint:1" },
        { "name": "creator_token", "source": "wallet_token_account:0", "writable": true },
        { "name": "creator_quote", "source": "wallet_token_account:1", "writable": true },
        { "name": "token_vault", "source": "vault:0", "writable": true },
        { "name": "quote_vault", "source": "vault:1", "writable": true },
        { "name": "token_program_token", "source": "token_program:0" },
        { "name": "token_program_quote", "source": "token_program:1" },
        { "name": "config", "source": "pda:EZwLuZ8mSiBoeKtbHwQK4kxCqqj4JuureT1kHpTK3i6b:str:config" },
        { "name": "treasury", "source": "fixed:CUiq3QQbXMsrgCpiN423zr2NTrdfPRuGUy9EQKQ6CGap", "writable": true },
