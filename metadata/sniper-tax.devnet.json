{
  "schema": "pipeline-strategy-metadata/1",
  "name": "Sniper Tax Launch",
  "description": "Launch pool with a sniper tax: buys right after launch pay up to 99% tax on their input, falling linearly to 0% within minutes (for example 90 or 600 seconds). The creator trades tax-free and receives 90% of the tax; 10% goes to the protocol. Sells are never taxed. Launch liquidity is locked for good. The launch token must have no mint or freeze authority and no transfer hook; a transfer fee on either mint must be fixed (no fee authority) and at most 5%. Pools are created by the project's own launcher, because their address includes the creator and the tax schedule.",
  "links": {
    "source": "https://github.com/MajocoReborn/pipeline-sniper-tax-strate",
    "docs": "https://github.com/MajocoReborn/pipeline-sniper-tax-strate/blob/main/docs/INTEGRATION.md"
  },
  "init": {
    "args": [
      { "name": "creator", "type": "pubkey", "label": "Creator wallet (tax-exempt, receives the tax)" },
      { "name": "tax_start_bps", "type": "u16", "label": "Tax at launch, in basis points (at most 9900)" },
      { "name": "tax_end_bps", "type": "u16", "label": "Tax after the window, in basis points (at most 500)" },
      { "name": "tax_duration_secs", "type": "u32", "label": "Length of the tax window in seconds (60 to 1800)" }
    ],
    "accounts": [
      { "name": "token_mint", "source": "input:token_mint" },
      { "name": "quote_mint", "source": "input:quote_mint" },
      { "name": "token_vault", "source": "input:token_vault" },
      { "name": "quote_vault", "source": "input:quote_vault" },
      { "name": "token_program_token", "source": "input:token_program_token" },
      { "name": "token_program_quote", "source": "input:token_program_quote" },
      { "name": "associated_token_program", "source": "fixed:ATokenGPvbdGVxr1b2hvZbsiqW5xWH25efTNsLJA8knL" },
      { "name": "config", "source": "pda:EZwLuZ8mSiBoeKtbHwQK4kxCqqj4JuureT1kHpTK3i6b:str:config" }
    ]
  },
  "actions": [
